{
  "schema_version": 3,
  "id": "local.drama-hub",
  "name": "短剧广场",
  "version": "1.5.1",
  "description": "短剧广场：红果式 19 个分类聚合中文竖屏短剧与漫剧，新增红果目录频道（真人剧/漫剧/AI剧，实时片名与集数，按名找 PT 资源）、漫剧频道、自动追新（只下新集、全集下完即停）、多站点并行的防风控 PT 检索、只下 free 与 2xfree 的免费种。",
  "author": "哆啦A豆",
  "icon": "ui/icon.svg",
  "requires": {
    "api": "3.2"
  },
  "ui": {
    "entry": "ui/page.js"
  },
  "menu": {
    "title": "短剧广场",
    "order": 30
  },
  "jobs": [
    {
      "id": "submit",
      "entry": "jobs/actions.js",
      "handler": "submit",
      "recover": "recover",
      "title": "提交下载",
      "timeout_seconds": 300,
      "allow_overlap": true
    },
    {
      "id": "sync",
      "entry": "jobs/sync.js",
      "handler": "run",
      "title": "同步短剧库",
      "timeout_seconds": 900,
      "queue": false
    },
    {
      "id": "hg",
      "entry": "jobs/hg.js",
      "handler": "run",
      "recover": "recover",
      "title": "红果目录取数",
      "timeout_seconds": 120,
      "allow_overlap": true
    },
    {
      "id": "digest",
      "entry": "jobs/digest.js",
      "handler": "run",
      "title": "每日短剧速递",
      "timeout_seconds": 600,
      "default_schedule": "0 20 * * *"
    },
    {
      "id": "subs",
      "entry": "jobs/subs.js",
      "handler": "run",
      "recover": "recover",
      "title": "订阅巡检 / 自动追新",
      "timeout_seconds": 2400,
      "queue": false,
      "default_schedule": "*/5 * * * *"
    }
  ],
  "declared_usage": {
    "apis": [
      "GET /api/tmdb/trending",
      "GET /api/tmdb/search",
      "GET /api/tmdb/discover/tv",
      "GET /api/tmdb/tv/{id}",
      "GET /api/plugin-host/emby/libraries",
      "GET /api/plugin-host/emby/instances",
      "GET /api/plugin-host/emby/items",
      "GET /api/plugin-host/emby/episodes",
      "GET /api/pt/sites",
      "GET /api/pt/downloaders",
      "POST /api/pt/search",
      "POST /api/pt/download",
      "POST /api/extensions/v3/{id}/notify"
    ],
    "sites": [
      "https://hongguoduanju.com"
    ],
    "files": [],
    "risk": "仅调用本机 DIAN115 宿主自有接口（TMDB 代理、Emby、PT、通知）；红果频道向 hongguoduanju.com 读取公开的剧集目录（片名/集数/海报/简介），不读 Cookie、不取播放流；不上报任何数据到第三方。"
  }
}
