{
  "schema_version": 3,
  "id": "local.drama-hub",
  "name": "短剧广场",
  "version": "1.4.4",
  "description": "短剧广场：红果式 18 个分类聚合中文竖屏短剧与漫剧，真实海报、自动追新（只下新集、全集下完即停）、漫剧频道（动态漫/AI漫剧，PT 检索自动还原核心片名）、多站点并行的防风控 PT 检索（每站独立节奏+抖动、每部先问命中率最高的站、没搜到才流转、单站绝不并发、每日上限与时间预算断点续跑）、只下 free 与 2xfree 的免费种策略、下载器手动指定后固定使用、订阅自动下载与 Telegram 速递。",
  "author": "哆啦A豆",
  "icon": "ui/icon.svg",
  "requires": {
    "api": "3.2"
  },
  "ui": {
    "entry": "ui/page.js"
  },
  "menu": {
    "title": "短剧广场",
    "order": 30
  },
  "jobs": [
    {
      "id": "submit",
      "entry": "jobs/actions.js",
      "handler": "submit",
      "recover": "recover",
      "title": "提交下载",
      "timeout_seconds": 300,
      "allow_overlap": true
    },
    {
      "id": "sync",
      "entry": "jobs/sync.js",
      "handler": "run",
      "title": "同步短剧库",
      "timeout_seconds": 900,
      "queue": false
    },
    {
      "id": "digest",
      "entry": "jobs/digest.js",
      "handler": "run",
      "title": "每日短剧速递",
      "timeout_seconds": 600,
      "default_schedule": "0 20 * * *"
    },
    {
      "id": "subs",
      "entry": "jobs/subs.js",
      "handler": "run",
      "title": "订阅巡检 / 自动追新",
      "timeout_seconds": 2400,
      "queue": false,
      "default_schedule": "*/5 * * * *"
    }
  ],
  "declared_usage": {
    "apis": [
      "GET /api/tmdb/trending",
      "GET /api/tmdb/search",
      "GET /api/tmdb/discover/tv",
      "GET /api/tmdb/tv/{id}",
      "GET /api/plugin-host/emby/libraries",
      "GET /api/plugin-host/emby/instances",
      "GET /api/plugin-host/emby/items",
      "GET /api/plugin-host/emby/episodes",
      "GET /api/pt/sites",
      "GET /api/pt/downloaders",
      "POST /api/pt/search",
      "POST /api/pt/download",
      "POST /api/extensions/v3/{id}/notify"
    ],
    "sites": [],
    "files": [],
    "risk": "仅调用本机 DIAN115 宿主自有接口（TMDB 代理、Emby、PT、通知）。不读写宿主文件、不读取 Cookie 或 CookieCloud、不建立任何第三方直连、不上报任何数据。"
  }
}